{
  "info": {
    "name": "Help Vizinhos - Testes de API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes da API Help Vizinhos (Node.js + Express + MongoDB). Os testes descrevem o comportamento ESPERADO; os que falham apontam bugs documentados em BUGS.md."
  },
  "item": [
    {
      "name": "01 - Serviços",
      "item": [
        {
          "name": "CT01 - API no ar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CT02 - Cadastrar serviço salva o valor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/prof/criar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prof",
                "criar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"atividade\": \"Eletricista\",\n  \"diaria\": true,\n  \"hora\": false,\n  \"valor\": 150,\n  \"agendarData\": \"2026-12-01\",\n  \"agendarHorario\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sufixo', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('profId', body.saveProf && body.saveProf._id);",
                  "pm.test('Status 201 - Created', () => pm.response.to.have.status(201));",
                  "pm.test('BUG-01: valor do serviço é salvo', () => pm.expect(body.saveProf.valor).to.eql(150));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
